<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка «Древо языка» — упрощённая.

     Прежняя крона была собрана из трёх кругов, плюс земля и тёплый плод: пять
     фигур и четыре цвета. В мелком размере это читалось как зелёное облако с
     яблоком.

     Две попытки сделать крону одной фигурой не сработали, и это стоит
     записать: круг на палочке читался как леденец, а треугольник на палочке —
     как стрелка вверх. Одиночная фигура без «обвеса» не выглядит кроной.
     Поэтому крона здесь два круга: большой и горка сверху. Это всё ещё три
     фигуры одного цвета вместо пяти четырёх цветов, и дерево читается сразу.

     Плоско, без градиентов: в монохромной маске Android 13+ система берёт
     только альфу, и градиенты там превращаются в грязь.

     Холст 108×108. Безопасная зона — круг радиусом 36 от центра (54,54);
     верх горки отстоит от центра на 31, край большого круга — на 17,
     низ ствола — на 30. Всё внутри. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- крона: крупный круг и горка сверху -->
    <path
        android:fillColor="#3FB77C"
        android:pathData="M54,48 m-17,0 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z" />
    <path
        android:fillColor="#3FB77C"
        android:pathData="M54,33 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />

    <!-- ствол: линия со скруглёнными концами, чтобы не было второго
         прямоугольника в силуэте -->
    <path
        android:pathData="M54,62 L54,84"
        android:strokeColor="#3FB77C"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
</vector>