<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка «Древо языка».

     Прежняя была одним зелёным овалом с точкой: в мелком размере читалась как
     пятно, а не как дерево. Сейчас крона собрана из трёх кругов, есть ствол и
     земля — силуэт сходится и в 32px, и в монохромной маске Android 13+.

     Плоский рисунок, без градиентов: в монохромной маске система берёт только
     альфу, и градиенты там превращаются в грязь.

     Размер: холст 108×108, как требует adaptive icon. Безопасная зона —
     круг радиусом 36 от центра (54,54); всё, что ближе к краю, маска
     телефона может срезать. Земля поэтому на y=83, а не на 86. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- земля -->
    <path
        android:fillColor="#5C3A1E"
        android:pathData="M54,83 m-13,0 a13,3 0 1,0 26,0 a13,3 0 1,0 -26,0 Z" />

    <!-- ствол: слегка сужается книзу, чтобы дерево не казалось колышком -->
    <path
        android:fillColor="#8A5A2B"
        android:pathData="M49,54 L59,54 L57.5,83 L50.5,83 Z" />

    <!-- крона: боковые круги темнее верхнего, иначе сливается в облако -->
    <path
        android:fillColor="#3FB77C"
        android:pathData="M39,48 m-14.5,0 a14.5,14.5 0 1,0 29,0 a14.5,14.5 0 1,0 -29,0 Z" />
    <path
        android:fillColor="#3FB77C"
        android:pathData="M69,48 m-14.5,0 a14.5,14.5 0 1,0 29,0 a14.5,14.5 0 1,0 -29,0 Z" />
    <path
        android:fillColor="#46C98A"
        android:pathData="M54,36 m-15.5,0 a15.5,15.5 0 1,0 31,0 a15.5,15.5 0 1,0 -31,0 Z" />

    <!-- плод: единственная тёплая точка, она же даёт масштаб кроне -->
    <path
        android:fillColor="#F0B45C"
        android:pathData="M64,43 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" />
</vector>