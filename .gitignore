# Нативное Android-приложение (Kotlin + Compose)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
# Озвучка в res/raw — копия из audio/. Держим один источник: 36 mp3 не должны
# лежать в репозитории дважды. Перед сборкой их кладёт на место tools/sync-audio.ps1.
android/app/src/main/res/raw/
# Ключ подписи и его описание живут вне git: теряем файл — теряем
# возможность выпускать обновления поверх уже установленного приложения.
keystore/
*.jks
*.keystore

# Голос — staging, результат синтеза edge-tts. В репозитории лежит только
# итог в audio/, иначе одни и те же 2,9 МБ кочуют по трём папкам.
voice/samples/
voice/compare/

# Старая обёртка Capacitor: то, что не должно попасть в репозиторий.
# Проект сохранён как история 1.0.0, но больше не собирается — см. README.
android-app/node_modules/
android-app/android/
android-app/www/
android-app/tools/*.ps1.bak
android-app/keystore.properties
local.properties

